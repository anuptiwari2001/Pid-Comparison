# Copy this file to .env and fill in your values

# Ollama VLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Recommended for 4 GB VRAM + 16 GB RAM:
# Primary:  OLLAMA_MODEL=qwen3-vl:4b (or qwen2.5-vl:3b)
# Alt 1:    OLLAMA_MODEL=moondream      (Ultra-light 1.8B VLM)
# Alt 2:    OLLAMA_MODEL=llava:7b       (Standard LLaVA)
# Alt 3:    OLLAMA_MODEL=qwen2.5-vl:7b  (High precision, offloads to 16GB RAM)
OLLAMA_MODEL=qwen3-vl:4b

# Optional — server port (default 8080)
PORT=8080

